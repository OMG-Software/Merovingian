+    {
+        return canonicaljson::Value{std::move(members)};
+    }
+
+    [[nodiscard]] auto json_member(std::string key, canonicaljson::Value value) -> canonicaljson::ObjectMember
+    {
+        return canonicaljson::make_member(std::move(key), std::move(value));
