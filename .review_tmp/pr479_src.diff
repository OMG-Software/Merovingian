+                // Spec MUST: start/end are pagination tokens for GET /messages.
+                auto const* start = string_member(body, "start");
+                REQUIRE(start != nullptr);
+                REQUIRE(!start->empty());
+                auto const* end = string_member(body, "end");
+                REQUIRE(end != nullptr);
+                REQUIRE(!end->empty());
+            }
+        }
+    }
+}
+
