+[[nodiscard]] auto next_batch_of(std::string const& sync_body) -> std::string
+{
+    auto const obj = parse_object(sync_body);
+    auto const* nb = string_member(obj, "next_batch");
+    REQUIRE(nb != nullptr);
+    return *nb;
+}
