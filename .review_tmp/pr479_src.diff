+SCENARIO("event_property_is condition matches an exact, type-strict value", "[push]")
+{
+    GIVEN("an override rule matching content.m\\.mentions.room == true (boolean)")
+    {
+        auto ruleset_object = Object{};
+        ruleset_object.push_back(make_member(
+            "override", Value{Array{make_rule("room-mention-rule", true,
+                                              Array{cond_event_property_is("content.m\\.mentions.room", Value{true})},
+                                              Array{action_notify()})}}));
+        auto const ruleset = merovingian::push::parse_push_ruleset(ruleset_object);
+        auto const context = merovingian::push::PushEvaluationContext{"@receiver:example.org"};
+
+        WHEN("the property is the boolean true")
+        {
+            auto const event =
+                make_event("m.room.message", "@sender:example.org", "!room:example.org", mentions_content({}, true));
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("the rule matches and notifies")
+            {
+                REQUIRE(result.notify);
+                REQUIRE(result.matched_rule_id == "room-mention-rule");
+            }
+        }
+
+        WHEN("the property is the string \"true\" instead of the boolean")
+        {
+            auto mentions = Object{};
+            mentions.push_back(str_member("room", "true"));
+            auto content = Object{};
+            content.push_back(make_member("m.mentions", Value{std::move(mentions)}));
+            auto const event = make_event("m.room.message", "@sender:example.org", "!room:example.org", content);
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("the rule does not match (type strictness: a string is never equal to a boolean)")
+            {
+                REQUIRE_FALSE(result.notify);
+            }
+        }
+
+        WHEN("the property is absent entirely")
+        {
+            auto const event = make_event("m.room.message", "@sender:example.org", "!room:example.org",
+                                          Object{str_member("body", "no mentions here")});
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("the rule does not match (fails closed)")
+            {
+                REQUIRE_FALSE(result.notify);
+            }
+        }
+    }
+}
+
+SCENARIO("Escaped dot-separated property paths resolve a literal dot or backslash within a path segment", "[push]")
+{
+    GIVEN("an event with a content property literally named \"m.relates_to\" (a literal dot in the property name)")
+    {
+        // The property name "m.relates_to" contains a literal dot, so per
+        // docs/matrix-v1.19-spec/appendices.md#dot-separated-property-paths
+        // the condition key must escape it as "m\.relates_to" — written here
+        // as the C++ string literal "m\\.relates_to".
+        auto relates_to = Object{};
+        relates_to.push_back(str_member("rel_type", "m.replace"));
+        auto content = Object{};
+        content.push_back(make_member("m.relates_to", Value{std::move(relates_to)}));
+        auto const event = make_event("m.room.message", "@sender:example.org", "!room:example.org", content);
+        auto const context = merovingian::push::PushEvaluationContext{"@receiver:example.org"};
+
+        WHEN("event_property_is uses the escaped-dot key to reach the property")
+        {
+            auto ruleset_object = Object{};
+            ruleset_object.push_back(make_member(
+                "override", Value{Array{make_rule("escaped-dot-rule", true,
+                                                  Array{cond_event_property_is("content.m\\.relates_to.rel_type",
+                                                                               Value{std::string{"m.replace"}})},
+                                                  Array{action_notify()})}}));
+            auto const ruleset = merovingian::push::parse_push_ruleset(ruleset_object);
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("the escaped dot is treated as part of the segment name, not a path separator, and the rule matches")
+            {
+                REQUIRE(result.notify);
+                REQUIRE(result.matched_rule_id == "escaped-dot-rule");
+            }
+        }
+
+        WHEN("event_match (the pre-existing condition kind) uses the same escaped-dot key")
+        {
+            auto ruleset_object = Object{};
+            ruleset_object.push_back(make_member(
+                "override",
+                Value{Array{make_rule("escaped-dot-event-match", true,
+                                      Array{cond_event_match("content.m\\.relates_to.rel_type", "m.replace")},
+                                      Array{action_notify()})}}));
+            auto const ruleset = merovingian::push::parse_push_ruleset(ruleset_object);
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("event_match resolves the same escaped path correctly, sharing the same path-splitting logic")
+            {
+                REQUIRE(result.notify);
+                REQUIRE(result.matched_rule_id == "escaped-dot-event-match");
+            }
+        }
+    }
+
+    GIVEN("an event with a content property literally named \"m\\foo\" (a literal backslash in the property name)")
+    {
+        // The property name "m\foo" contains a literal backslash, so the
+        // spec requires escaping it as "m\\foo" in the path. In C++ source,
+        // the object's actual key is written "m\\foo" (one escaped
+        // backslash -> runtime "m\foo"), and the lookup path is written
+        // "content.m\\\\foo" (two escaped backslashes -> runtime
+        // "content.m\\foo", i.e. an escaped literal backslash followed by
+        // "foo").
+        auto content = Object{};
+        content.push_back(str_member("m\\foo", "bar"));
+        auto const event = make_event("m.room.message", "@sender:example.org", "!room:example.org", content);
+        auto const context = merovingian::push::PushEvaluationContext{"@receiver:example.org"};
+
+        auto ruleset_object = Object{};
+        ruleset_object.push_back(make_member(
+            "override",
+            Value{Array{make_rule("escaped-backslash-rule", true,
+                                  Array{cond_event_property_is("content.m\\\\foo", Value{std::string{"bar"}})},
+                                  Array{action_notify()})}}));
+        auto const ruleset = merovingian::push::parse_push_ruleset(ruleset_object);
+
+        WHEN("the event is evaluated")
+        {
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("the escaped backslash resolves to the literal property name and the rule matches")
+            {
+                REQUIRE(result.notify);
+                REQUIRE(result.matched_rule_id == "escaped-backslash-rule");
+            }
+        }
+    }
+}
+
+SCENARIO("Unresolvable property paths never match event_property_is or event_property_contains", "[push]")
+{
+    GIVEN("rules targeting a path that does not exist and a path that walks through a non-object")
+    {
+        auto ruleset_object = Object{};
+        ruleset_object.push_back(make_member(
+            "override",
+            Value{
+                Array{make_rule("missing-path-is", true,
+                      Array{cond_event_property_is("content.does.not.exist", Value{std::string{"x"}})},
+                      Array{action_notify()}),
+                      make_rule("through-scalar-contains", true,
+                      Array{cond_event_property_contains("content.body.nested", Value{std::string{"x"}})},
+                      Array{action_notify()})}
+        }));
+        auto const ruleset = merovingian::push::parse_push_ruleset(ruleset_object);
+        auto const context = merovingian::push::PushEvaluationContext{"@receiver:example.org"};
+
+        WHEN("the event has neither the missing property nor an object at the intermediate segment")
+        {
+            auto const event = make_event("m.room.message", "@sender:example.org", "!room:example.org",
+                                          Object{str_member("body", "just a plain string")});
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("no rule matches and the outcome is dont_notify")
+            {
+                REQUIRE_FALSE(result.notify);
+                REQUIRE(result.matched_rule_id.empty());
+            }
+        }
+    }
+}
+
+SCENARIO("The default .m.rule.is_user_mention and .m.rule.is_room_mention rules notify on @-mentions", "[push]")
+{
+    GIVEN("override rules built in the exact shape default_push_ruleset() produces for the mention rules")
+    {
+        auto ruleset_object = Object{};
+        ruleset_object.push_back(make_member(
+            "override",
+            Value{
+                Array{
+                      make_rule(".m.rule.is_user_mention", true,
+                      Array{cond_event_property_contains("content.m\\.mentions.user_ids",
+                                                                 Value{std::string{"@receiver:example.org"}})},
+                      Array{action_notify(), action_set_tweak_sound("default"), action_set_tweak_highlight()}),
+                      make_rule(".m.rule.is_room_mention", true,
+                      Array{cond_event_property_is("content.m\\.mentions.room", Value{true}),
+                                    cond_sender_notification_permission("room")},
+                      Array{action_notify(), action_set_tweak_highlight()}),
+                      }
+        }));
+        auto const ruleset = merovingian::push::parse_push_ruleset(ruleset_object);
+        auto context = merovingian::push::PushEvaluationContext{"@receiver:example.org"};
+        context.notification_power_levels["room"] = 50;
+
+        WHEN("the event's m.mentions.user_ids array contains the receiving user's ID")
+        {
+            auto const event = make_event("m.room.message", "@sender:example.org", "!room:example.org",
+                                          mentions_content(Array{Value{std::string{"@receiver:example.org"}}}, false));
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("is_user_mention matches and notifies with sound and highlight tweaks")
+            {
+                REQUIRE(result.notify);
+                REQUIRE(result.matched_rule_id == ".m.rule.is_user_mention");
+                REQUIRE(result.tweak_sound == std::optional<std::string>{"default"});
+                REQUIRE(result.tweak_highlight);
+            }
+        }
+
+        WHEN("the event's m.mentions.room is true and the sender has the required notification power level")
+        {
+            context.sender_power_level = 50;
+            auto const event =
+                make_event("m.room.message", "@sender:example.org", "!room:example.org", mentions_content({}, true));
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("is_room_mention matches and notifies with a highlight tweak")
+            {
+                REQUIRE(result.notify);
+                REQUIRE(result.matched_rule_id == ".m.rule.is_room_mention");
+                REQUIRE(result.tweak_highlight);
+            }
+        }
+
+        WHEN("the event's m.mentions.room is true but the sender lacks the required notification power level")
+        {
+            context.sender_power_level = 0;
+            auto const event =
+                make_event("m.room.message", "@sender:example.org", "!room:example.org", mentions_content({}, true));
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("is_room_mention does not match")
+            {
+                REQUIRE_FALSE(result.notify);
+            }
+        }
+
+        WHEN("the event carries no m.mentions property at all")
+        {
+            auto const event = make_event("m.room.message", "@sender:example.org", "!room:example.org",
+                                          Object{str_member("body", "just a regular message")});
+            auto const result = merovingian::push::evaluate_push_rules(ruleset, event, context);
+
+            THEN("neither mention rule matches and the outcome is dont_notify")
+            {
+                REQUIRE_FALSE(result.notify);
+                REQUIRE(result.matched_rule_id.empty());
+            }
+        }
+    }
+}
diff --git a/tests/unit/test_runtime_orphan_futures.cpp b/tests/unit/test_runtime_orphan_futures.cpp
new file mode 100644
index 00000000..7a836b4d
--- /dev/null
+++ b/tests/unit/test_runtime_orphan_futures.cpp
@@ -0,0 +1,209 @@
+// SPDX-FileCopyrightText: 2026 James Chapman
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Coverage: the reap-before-park / fixed-cap policy that bounds
+// HomeserverRuntime::orphan_futures_ background task pool (used by both
+// join_room's make_join race losers and room_service.cpp's
+// dispatch_push_deliveries). Exercises reap_completed_futures and
+// at_background_task_capacity directly, deterministically — via
+// std::promise instead of real background threads — so the policy is
+// provable without any timing dependence. See test_push_delivery_flow.cpp
+// for the end-to-end proof that dispatch_push_deliveries actually calls
+// these at the real call site.
+
+#include "merovingian/homeserver/runtime.hpp"
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+#include <cstddef>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+SCENARIO("reap_completed_futures removes only already-finished futures", "[homeserver][runtime][push]")
+{
+    GIVEN("one already-completed future ahead of one still-running future")
+    {
+        auto done_promise = std::promise<void>{};
+        auto done_future = done_promise.get_future();
+        done_promise.set_value();
+
+        auto pending_promise = std::promise<void>{};
+        auto pending_future = pending_promise.get_future();
+
+        auto futures = std::vector<std::future<void>>{};
+        futures.push_back(std::move(done_future));
+        futures.push_back(std::move(pending_future));
+
+        WHEN("the vector is reaped")
+        {
+            merovingian::homeserver::reap_completed_futures(futures);
+
+            THEN("only the still-running future survives, in its original relative order")
+            {
+                REQUIRE(futures.size() == 1U);
+                REQUIRE(futures[0].valid());
+
+                // Resolve it here so the pending promise does not go unset for the
+                // rest of the test run; reap_completed_futures never touches a
+                // still-running future beyond a non-blocking readiness check.
+                pending_promise.set_value();
+                futures[0].wait();
+            }
+        }
+    }
+
+    GIVEN("every future already completed")
+    {
+        auto futures = std::vector<std::future<void>>{};
+        for (auto i = 0; i < 3; ++i)
+        {
+            auto promise = std::promise<void>{};
+            auto future = promise.get_future();
+            promise.set_value();
+            futures.push_back(std::move(future));
+        }
+
+        WHEN("the vector is reaped")
+        {
+            merovingian::homeserver::reap_completed_futures(futures);
+
+            THEN("the vector ends up empty rather than accumulating completed entries")
+            {
+                REQUIRE(futures.empty());
+            }
+        }
+    }
+
+    GIVEN("an empty vector")
+    {
+        auto futures = std::vector<std::future<void>>{};
+
+        WHEN("the vector is reaped")
+        {
+            merovingian::homeserver::reap_completed_futures(futures);
+
+            THEN("it stays empty and reaping is a no-op")
+            {
+                REQUIRE(futures.empty());
+            }
+        }
+    }
+}
+
+SCENARIO("at_background_task_capacity gates new background work at a fixed bound", "[homeserver][runtime][push]")
+{
+    GIVEN("a cap of 3 in-flight tasks")
+    {
+        constexpr auto cap = std::size_t{3U};
+
+        WHEN("fewer tasks are in flight than the cap")
+        {
+            THEN("there is room for one more")
+            {
+                REQUIRE_FALSE(merovingian::homeserver::at_background_task_capacity(0U, cap));
+                REQUIRE_FALSE(merovingian::homeserver::at_background_task_capacity(2U, cap));
+            }
+        }
+
+        WHEN("exactly the cap is already in flight")
+        {
+            THEN("the next unit of work must be dropped rather than spawned")
+            {
+                REQUIRE(merovingian::homeserver::at_background_task_capacity(3U, cap));
+            }
+        }
+
+        WHEN("more than the cap is somehow in flight")
+        {
+            THEN("it still reports at capacity")
+            {
+                REQUIRE(merovingian::homeserver::at_background_task_capacity(4U, cap));
+            }
+        }
+    }
+}
+
+// Regression coverage for the production-facing deadlock this branch fixes:
+// dispatch_push_deliveries's background task used to decrement
+// push_delivery_in_flight_ as its final action while holding
+// orphan_futures_mutex_ — the same mutex HomeserverRuntime::~HomeserverRuntime()
+// took for the entire drain, including its blocking future.wait() calls. A
+// runtime destroyed while a push-delivery task was still in flight would
+// deadlock: the destructor waited on the future while holding the mutex the
+// task needed to finish, and the task could never acquire it. Fixed by (1)
+// making push_delivery_in_flight_ a std::atomic so the task's decrement never
+// needs the mutex at all, and (2) having the destructor hold the mutex only
+// long enough to move the futures out of orphan_futures_, releasing it before
+// the blocking wait(). This test exercises (2) directly and deterministically:
+// the parked task is held closed on an external gate for the whole polling
+// window, so the destructor cannot finish regardless of its locking
+// discipline — a destructor that still holds the mutex across the wait will
+// show it held for the entire window (nothing else can free it); a destructor
+// that releases it first will show it free almost immediately.
+SCENARIO("HomeserverRuntime's destructor releases orphan_futures_mutex_ before blocking on a still-running "
+         "background task",
+         "[homeserver][runtime][push]")
+{
+    GIVEN("a runtime with a push-delivery-shaped background task parked in orphan_futures_, still blocked on "
+          "external I/O when destruction begins")
+    {
+        auto runtime_holder = std::make_unique<merovingian::homeserver::HomeserverRuntime>();
+        auto& mutex_ref = runtime_holder->orphan_futures_mutex_;
+
+        auto release_promise = std::promise<void>{};
+        auto release_future = release_promise.get_future();
+
+        // Mirrors dispatch_push_deliveries's real background task: its only
+        // remaining work is gated on external I/O (here, a promise standing
+        // in for a slow push gateway) and, matching the fix, its completion
+        // never needs orphan_futures_mutex_.
+        auto task_future = std::async(std::launch::async, [fut = std::move(release_future)]() mutable {
+            fut.wait();
+        });
+
+        {
+            auto const lock = std::lock_guard{mutex_ref};
+            runtime_holder->orphan_futures_.push_back(std::move(task_future));
+        }
+
+        WHEN("the runtime is destroyed on another thread while the background task is still blocked")
+        {
+            auto destruct_thread = std::thread{[holder = std::move(runtime_holder)]() mutable {
+                holder.reset();
+            }};
+
+            // The task's gate stays closed for this entire window, so the
+            // destructor's future.wait() cannot return no matter what it
+            // does with the mutex — this makes the poll below unambiguous.
+            auto acquired_promptly = false;
+            auto const deadline = std::chrono::steady_clock::now() + std::chrono::seconds{2};
+            while (std::chrono::steady_clock::now() < deadline)
+            {
+                if (mutex_ref.try_lock())
+                {
+                    mutex_ref.unlock();
+                    acquired_promptly = true;
+                    break;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds{1});
+            }
+
+            // Open the gate so the task — and, transitively, the
+            // destructor's wait() — can finish regardless of the outcome
+            // above, then join before asserting: a still-joinable
+            // std::thread destroyed while unwinding a failed REQUIRE calls
+            // std::terminate instead of reporting the failure.
+            release_promise.set_value();
+            destruct_thread.join();
+
+            THEN("the mutex became available again while the background task was still running")
+            {
+                REQUIRE(acquired_promptly);
+            }
+        }
+    }
+}
diff --git a/tests/unit/test_trust_safety_ignore_list.cpp b/tests/unit/test_trust_safety_ignore_list.cpp
