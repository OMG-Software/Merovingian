# misc-use-anonymous-namespace is off here only: every Catch2 SCENARIO expands to a static function
# (dummyFunctionN) that the check flags, so any new scenario would fail clang-tidy (ADR-0847).
Checks: >
  -*,
  bugprone-*,
  -bugprone-branch-clone,
  -bugprone-chained-comparison,
  -bugprone-easily-swappable-parameters,
  cert-*,
  -cert-err33-c,
  clang-analyzer-*,
  misc-*,
  -misc-include-cleaner,
  -misc-use-anonymous-namespace,
  portability-*
WarningsAsErrors: '*'
HeaderFilterRegex: '^tests/.*'
