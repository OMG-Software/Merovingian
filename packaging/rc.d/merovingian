#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later

# PROVIDE: merovingian
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="merovingian"
rcvar="merovingian_enable"
command="/usr/local/bin/merovingian-server"
command_args="--config ${merovingian_config:-/usr/local/etc/merovingian/merovingian.conf}"
merovingian_user="${merovingian_user:-merovingian}"
pidfile="/var/run/merovingian/merovingian.pid"

start_precmd="merovingian_precmd"

merovingian_precmd() {
    install -d -o "${merovingian_user}" -g "${merovingian_user}" -m 0750 /var/run/merovingian
    install -d -o "${merovingian_user}" -g "${merovingian_user}" -m 0750 /var/db/merovingian
    install -d -o "${merovingian_user}" -g "${merovingian_user}" -m 0750 /var/log/merovingian
}

load_rc_config "$name"
: "${merovingian_enable:=NO}"
# Every secret the server holds sits in a locked page, and a secret file is not read without one (docs/hardening.md,
# "Locked memory"). rc.subr passes this to limits(1), so the budget does not depend on the login class: FreeBSD's
# default class allows 64 KiB, which is 16 secrets. Set merovingian_limits in rc.conf to change it.
: "${merovingian_limits:=-l 128m}"
run_rc_command "$1"
