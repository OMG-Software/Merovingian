[Unit]
Description=The Merovingian Matrix homeserver
Documentation=file:/usr/share/doc/merovingian/production-readiness.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=merovingian
Group=merovingian
UMask=0077
ExecStart=/usr/bin/merovingian-server --config /etc/merovingian/merovingian.conf
Restart=on-failure
RestartSec=5s
RuntimeDirectory=merovingian
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/merovingian /var/log/merovingian
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# ISO-8 (ADR-0147): TCP/UDP for clients, federation and DNS; AF_UNIX for the
# worker IPC channel and a local PostgreSQL socket. glibc falls back cleanly
# when its address-sorting netlink probe gets EAFNOSUPPORT.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

[Install]
WantedBy=multi-user.target
