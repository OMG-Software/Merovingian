  'DeviceListDelta.cpp',
  'HistoryVisibility.cpp',
  'LazyMemberTracker.cpp',
  'ParkedPollRegistry.cpp',
  'PreparedRoomEventFilter.cpp',
  'ReadMarkers.cpp',
  'ReceiptContentBuilder.cpp',
  'receipt_visibility.cpp',
  'RoomAccess.cpp',
  'RoomReadAccess.cpp',
  'state_group_lookup.cpp',
  'sliding_sync_extensions.cpp',
  'sliding_sync_parser.cpp',
  'sliding_sync_room_builder.cpp',
  'sliding_sync_room_list.cpp',
  'StreamToken.cpp',
  'SyncFilter.cpp',
  'SyncNotifier.cpp',
  'ThreadNotificationCounts.cpp',
